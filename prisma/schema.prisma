// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A Page is the single base unit: a regular page, a database, or a row
// inside a database (rows are just pages parented under the database page).
model Page {
  id       String  @id @default(cuid())
  title    String  @default("Untitled")
  parentId String?
  parent   Page?   @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Page[]  @relation("PageHierarchy")

  // Ordinary block content of this page.
  blocks Block[] @relation("PageBlocks")

  // Blocks elsewhere that render this page inline (page_link blocks pointing at this page).
  linkedByBlocks Block[] @relation("BlockLinkedPage")

  // Set when this page has been turned into a database (i.e. has a schema).
  isDatabase Boolean            @default(false)
  properties DatabaseProperty[] @relation("DatabaseProperties")

  // Set when this page is a row inside a database (its parent isDatabase page).
  // Holds the value for each of the parent database's properties.
  propertyValues PropertyValue[] @relation("RowPropertyValues")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

enum BlockType {
  text
  heading
  bulleted_list_item
  numbered_list_item
  page_link
}

// A block of content inside a page.
// - text / heading / bulleted_list_item / numbered_list_item: `content` holds
//   a JSON-encoded Span[] (see lib/block-content.ts) with inline formatting.
// - page_link: `content` is null; renders the page at `linkedPageId`.
model Block {
  id     String    @id @default(cuid())
  pageId String
  page   Page      @relation("PageBlocks", fields: [pageId], references: [id], onDelete: Cascade)
  type   BlockType
  order  Int       @default(0)

  content      String? // JSON-encoded Span[] for text/heading/list blocks
  headingLevel Int? // 1-3, used by type: heading

  linkedPageId String? // used by type: page_link
  linkedPage   Page?   @relation("BlockLinkedPage", fields: [linkedPageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

enum PropertyType {
  text
  select
  date
}

// A single column in a database's schema. Lives on the database page.
model DatabaseProperty {
  id     String       @id @default(cuid())
  pageId String
  page   Page         @relation("DatabaseProperties", fields: [pageId], references: [id], onDelete: Cascade)
  name   String
  type   PropertyType
  order  Int          @default(0)

  // JSON-encoded array of string options, only used when type = select.
  selectOptions String? @default("[]")

  values PropertyValue[] @relation("PropertyValues")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

// The value of one property, for one row (a row is just a Page).
model PropertyValue {
  id         String           @id @default(cuid())
  pageId     String
  page       Page             @relation("RowPropertyValues", fields: [pageId], references: [id], onDelete: Cascade)
  propertyId String
  property   DatabaseProperty @relation("PropertyValues", fields: [propertyId], references: [id], onDelete: Cascade)

  // Stored as plain text for all property types: free text, the selected
  // option label, or an ISO date string. Kept simple on purpose.
  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, propertyId])
  @@index([propertyId])
}
